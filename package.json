  "description": "Merge bookmarks between iTab (Chrome new tab) and WeTab (Edge new tab) by topic — no copy-pasting URLs, no touching the extension databases.",
  "type": "module",
  "main": "merge.mjs",
  "bin": {
    "itab-wetab-sync": "merge.mjs"
  },
