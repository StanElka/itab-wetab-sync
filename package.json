  },
  "keywords": [
    "itab",
    "wetab",
    "new-tab",
    "bookmarks",
    "chrome-extension",
    "edge-extension",
    "migration",
    "sync"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    "merge.mjs",
    "selftest.mjs",
    "README.md",
    "LICENSE"
  ]
